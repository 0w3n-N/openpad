{
  "schemaVersion": 1,
  "id": "io.github.0w3n-n.openpad",
  "name": "OpenPad",
  "version": "0.5.0",
  "author": "0w3n-N",
  "license": "MIT",
  "description": "Notes for iPad and Apple Pencil: notebooks with sections and pages, PDF annotation, and a live share window for calls. Guests can watch and write along by link, and every notebook syncs to your computer. Optional AirPlay mirroring.",
  "homepage": "https://github.com/0w3n-N/openpad",
  "repository": "https://github.com/0w3n-N/openpad",
  "keywords": [
    "ipad",
    "apple pencil",
    "notes",
    "notebook",
    "pdf",
    "whiteboard",
    "annotate",
    "sync",
    "airplay",
    "education"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OpenPad",
    "description": "Start OpenPad, pair the iPad, open the share window, invite people, annotate a desktop window, and toggle AirPlay mirroring.",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "port": 8770,
      "airplayName": "Omarchy",
      "airplayAudio": "on"
    },
    "schema": [
      {
        "key": "port",
        "type": "integer",
        "label": "OpenPad port",
        "min": 1024,
        "max": 65535,
        "step": 1,
        "defaultValue": 8770
      },
      {
        "key": "airplayName",
        "type": "string",
        "label": "AirPlay name shown on the iPad",
        "defaultValue": "Omarchy"
      },
      {
        "key": "airplayAudio",
        "type": "enum",
        "label": "Play iPad audio while mirroring",
        "options": [
          {
            "value": "on",
            "label": "On"
          },
          {
            "value": "off",
            "label": "Off"
          }
        ],
        "defaultValue": "on"
      }
    ]
  }
}
